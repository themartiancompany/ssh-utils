_bin="$(
  dirname \
    "$(command \
        -v \
	"env")")"
_lib="${_bin}/../lib"
_share="${_bin}/../share"
source \
  "${_lib}/libcrash-bash/crash-bash"

_global_variables() {
  override_quiet="y"
  out_file=""
  target_host=""
  target_hostname=""
  target_user=""
  target_port=""
  proxy_command=""
  proxy_address=""
  proxy_port=""
  proxy_command=""
  tunnel_local=""
  tunnel_remote=""
  strict_host_check=""
  color=""
  quiet="y"
}

_get_nc_cmd() {
  local \
    _address="${1}" \
    _port="${2}" \
    _cmd=()
  _cmd=(
      nc
        -X
          5
        -x
          "${_address}:${_port}"
        "%h"
        "%p"
  )
  echo \
    "${_cmd[*]}"
}

# Writes SSH configuration
_ssh_conf() {
  local \
    _out="${1}" \
    _host="${2}" \
    _hostname="${3}" \
    _user="${4}" \
    _port="${5}" \
    _proxy_address="${6}" \
    _proxy_port="${7}" \
    _proxy_command="${8}" \
    _tunnel_local="${9}" \
    _tunnel_remote="${10}" \
    _strict_host_check="${11}" \
    _out \
    _cfg=()
  _cfg=(
    "Host ${_host}"
    "  HostName ${_hostname}"
    "  Port ${_port}"
    "  IdentityFile ${HOME}/.ssh/${_host}"
    "  User ${_user}"
  )
  if [[ "${_strict_host_check}" ]]; then
    _cfg+=( 
      "  StrictHostKeyChecking no"
    )
  fi
  if \
    [[ "${_tunnel_local}" != "" ]] || \
    [[ "${_tunnel_remote}" != "" ]]; then
    if \
      [[ "${_tunnel_remote}" == "" ]]; then
      _tunnel_remote="${_tunnel_local}"
    fi
    if [[ "${_tunnel_local}" == "" ]]; then
      _tunnel_local="${_tunnel_remote}"
    fi
    _cfg+=(
      "  LocalForward ${_tunnel_local} localhost:${_tunnel_remote}"
    )
  fi
  if \
    [[ "${_hostname}" == *".onion" ]] || \
    [[ "${_proxy_address}" != "" ]]; then
    _cfg+=(
      "  VerifyHostKeyDNS no"
      "  ProxyCommand $(
        _get_"${_proxy_command}"_cmd \
          "${_proxy_address}" \
          "${_proxy_port}")"
    )
  fi
  printf \
    '%s\n' \
    "${_cfg[@]}" > \
    "${_out}"
  chmod \
    600 \
    "${_out}"
}

_set_overrides() {
  if [[ -v override_color ]]; then
    color="${override_color}"
  elif [[ -z "${color}" ]]; then
    color="n"
  fi
  if [[ -v override_quiet ]]; then
    quiet="${override_quiet}"
  elif [[ -z "${quiet}" ]]; then
    quiet="y"
  fi
  _set_override \
    "proxy" \
    "command" \
    "nc"
  _set_override \
    "proxy" \
    "address" \
    ""
  _set_override \
    "proxy" \
    "port" \
    "9050"
  _set_override \
    "tunnel" \
    "local" \
    ""
  _set_override \
    "tunnel" \
    "remote" \
    ""
  _set_override \
    "strict_host" \
    "check" \
    "no"
}

# Show help usage, with an exit status.
# $1: exit status number.
_usage() {
  local \
    _exit_code="${1}"
  IFS='' \
  read \
    -r \
    -d \
    '' \
    usagetext \
  <<ENDUSAGETEXT || true

usage:
  ${app_name}
    [options] 
      <out_file>
      <target-host>
      <target-hostname>
      <target-user>
      <target-port>

  arguments:

     out file:               Path of the resulting
                             configuration file.
     target host             Name of the resulting host.
     target hostname         Target address or domain name
                             or seed name.
     target user:            User to connect to.
     target port:            Port to connect to.

  options:

     -m <proxy-command>   Proxy command
     -p <proxy-address>   Proxy address
     -P <proxy-port>      Proxy port
                          Default: ${proxy_port}
     -l <local-port>      Tunnel on given local port
                          Default: '${tunnel_local}'
     -r <remote-port>     Tunnel on given remote port
                          Default: '${tunnel_remote}'
     -h                   This message
     -c                   Enable color output
     -v                   Enable verbose output

ENDUSAGETEXT
  printf \
    '%s' \
    "${usagetext}"
  exit \
    "${_exit_code}"
}

_globals
_global_variables

while \
  getopts \
    'm:p:P:l:r:vh?' arg; do
  case "${arg}" in
    m)
      override_proxy_command="${OPTARG}" ;;
    p)
      override_proxy_address="${OPTARG}" ;;
    P)
      override_proxy_port="${OPTARG}" ;;
    l)
      override_tunnel_local="${OPTARG}" ;;
    r)
      override_tunnel_remote="${OPTARG}" ;;
    c)
      override_color="y" ;;
    v)
      override_quiet="n" ;;
    h|?)
      _usage 0 ;;
    *)
      _msg=(
        "Invalid argument '${arg}'."
      )
      _msg_error \
        "${_msg[*]}" \
        0
        _usage \
          0 ;;
  esac
done
shift \
  $((OPTIND - 1))
if (( "$#" < 5 )); then
  _msg=(
    "Missing argument."
  )
  _msg_error \
    "${_msg[*]}" \
    0
  _usage \
    0
fi
out_file="${1}"
target_host="${2}"
target_hostname="${3}"
target_user="${4}"
target_port="${5}"
shift \
  5
command_args=(
  "$@"
)
app_opts+=(
  "${out_file}"
  "${target_host}"
  "${target_hostname}"
  "${target_user}"
  "${target_port}"
  "${proxy_address}"
  "${proxy_port}"
  "${proxy_command}"
  "${tunnel_local}"
  "${tunnel_remote}"
  "${strict_host_check}"
  "${command_args[@]}"
)
_set_overrides
_ssh_conf \
  "${app_opts[@]}"

